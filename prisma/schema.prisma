generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ---------------- Enums ----------------
 */

enum MemberStatus {
  LAOBAN
  PEIWAN
}

enum EntryKind {
  DIANDAN
  DASHANG
  TIXIAN
  RECHARGE
}

enum PeiwanStatus {
  busy
  free
}

enum OrderMode {
  REALNAME
  ANONYMOUS
}

enum OrderStatus {
  PENDING
  RUNNING
  ENDED
  DECLINED
  CANCELED
  EXPIRED
}

enum RechargeOrderStatus {
  PENDING
  PAID
  FAILED
}

enum QuotationCode {
  Q1
  Q2
  Q3
  Q4
  Q5
  Q6
  Q7
  Q8
  Q9
  Q10
}

enum PeiwanSex {
  小姐姐
  小哥哥
}

enum PeiwanType {
  娱乐陪玩
  技术陪玩
  大神陪玩
}

enum PeiwanGameCode {
  LOL
  CSGO
  VAL
  NARAKA
  OW
  APEX
  DELTA
  MARVEL
  TFT
  TARKOV
  DOTA
  COD
  CHAT
  SINGER
}

enum PeiwanGameTier {
  ENTERTAINMENT
  TRAINEE
  TECH
  MASTER
  DEMON_GUARD
}

enum FarmSeedType {
  WHEAT
  ROSE
  KOI_FLOWER
  MYSTERY_FRUIT
}

enum FarmActionType {
  BALANCE_TO_COINS
  POINTS_TO_COINS
  COINS_TO_POINTS
  PLANT
  HARVEST
  EXPAND
  STEAL
}

enum PeiwanLevel {
  优选陪玩
  明星陪玩
  殿堂陪玩
}

enum RedEnvelopeStatus {
  ACTIVE
  FINISHED
  REFUNDED
}

enum LotteryPool {
  NORMAL   // 银色
  MEDIUM   // 金色
  ADVANCED // 高级（有限）
  SPECIAL  // 特级（有限）
}

enum LotteryPrizeType {
  COUPON
  GIFT
  OTHER
  SELFUSE
}

/**
 * ---------------- Models ----------------
 */

model Activity {
  title       String   @id
  description String?
  type        String?
}

model Member {
  // Primary key is the Discord user id
  discordUserId String       @id
  status        MemberStatus @default(LAOBAN)

  // Money
  totalBalance Decimal @default(0) @db.Decimal(19, 4)
  income       Decimal @default(0) @db.Decimal(19, 4)
  recharge     Decimal @default(0) @db.Decimal(19, 4)
  totalSpent   Decimal @default(0) @db.Decimal(19, 4)
  VIPRoleOptOut Boolean @default(false)

  // Payout rate (user receives this share of gross), default 75%
  commissionRate Decimal @default(0.75) @db.Decimal(7, 6)
  // Original payout share baseline, used when temporary boosts expire
  baseCommissionRate Decimal @default(0.75) @db.Decimal(7, 6)

  // Relations
  commissionFrom Commission[] @relation("CommissionFrom")
  commissionTo   Commission[] @relation("CommissionTo")
  dailySnapshots DailySnapshot[]

  sentTransactions     Transaction[] @relation("FromMember")
  receivedTransactions Transaction[] @relation("ToMember")
  zpayRechargeOrders   ZPayRechargeOrder[]

  // One-to-one: every 陪玩 is a member; not every member is a 陪玩
  peiwan PEIWAN? @relation("MemberToPeiwan")
  // Loyalty points (one-to-one)
  loyaltyPoint LoyaltyPoint?
  // Farm profile (one-to-one)
  farmProfile FarmProfile?
  // Withdrawal account presets (one-to-one)
  withdrawalAccount WithdrawalAccount?

  // Orders (reverse edges)
  ordersAsHost   Order[] @relation("HostOrders")
  ordersAsWorker Order[] @relation("WorkerOrders")

  // Heart counters (from → to)
  heartFrom HeartCounter[] @relation("HeartFrom")
  heartTo   HeartCounter[] @relation("HeartTo")

  // Lottery draws
  lotteryDraws LotteryDraw[]
  lotteryPity  LotteryPity?
  scratchTickets ScratchTicket[] @relation("ScratchTicketOwner")
  pointShopCarts PointShopCart[]
  pointShopOrders PointShopOrder[]
  pointShopPointLedgers PointShopPointLedger[]
  pointShopGrants PointShopGrant[] @relation("PointShopGrantOwner")
  pointShopGrantConsumes PointShopGrant[] @relation("PointShopGrantConsumeTarget")
  authoredPeiwanReviews PeiwanReview[] @relation("PeiwanReviewReviewer")
  receivedPeiwanReviews PeiwanReview[] @relation("PeiwanReviewPeiwan")
  voicePointSessions VoicePointSession[]
  voicePointLedgers VoicePointLedger[]
  pageViewEvents PageViewEvent[]

  // Gift wall unlocks/rewards
  giftUnlocks      PeiwanGiftUnlock[]
  giftRewardClaims PeiwanGiftRewardClaim[]

  // Back-relation for WorkerLock (one active lock at most)
  workerLock WorkerLock? @relation("MemberWorkerLock")

  // Invite link reward records
  inviteRewardsGiven    InviteLinkUsage[] @relation("MemberToInviteLinkUsage")
  inviteRewardsReceived InviteLinkUsage[] @relation("InviteeToInviteLinkUsage")

  // Referral relations
  referralInviter Referral[] @relation("ReferralInviter")
  referralInvitee Referral?  @relation("ReferralInvitee")

  // Display name inside target Discord guild
  serverDisplayName String?

  // Order request logs/clicks
  orderRequestsCreated OrderRequestLog[] @relation("OrderRequestOwner")
  orderRequestClicks   OrderRequestClick[] @relation("OrderRequestWorker")

  // Expense & profit logs
    expensesAsOperator Expense[] @relation("ExpenseOperator")
    expensesAsTarget   Expense[] @relation("ExpenseTarget")
    profitsAsOperator  PureProfit[] @relation("PureProfitOperator")
    profitsAsTarget    PureProfit[] @relation("PureProfitTarget")
    couponsAsConsumeTarget Coupon[] @relation("CouponConsumeTarget")
    lotteryConsumeTargets LotteryDraw[] @relation("LotteryConsumeTarget")
  }

model LoyaltyPoint {
  discordUserId String   @id
  points        Decimal  @default(0) @db.Decimal(19, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
}

model FarmProfile {
  discordUserId String   @id
  coins         Decimal  @default(0) @db.Decimal(19, 4)
  experience    Int      @default(0)
  unlockedPlots Int      @default(4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
  plots  FarmPlot[]
  logs   FarmActionLog[]
}

model FarmPlot {
  id            String        @id @default(cuid())
  discordUserId String
  plotIndex     Int
  seedType      FarmSeedType?
  plantedAt     DateTime?
  readyAt       DateTime?
  lastStolenAt  DateTime?
  lastStolenBy  String?
  stolenCoins   Decimal       @default(0) @db.Decimal(19, 4)
  lastHarvestAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile FarmProfile @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@unique([discordUserId, plotIndex])
  @@index([discordUserId, readyAt])
}

model FarmActionLog {
  id            String         @id @default(cuid())
  discordUserId String
  actionType    FarmActionType
  plotIndex     Int?
  seedType      FarmSeedType?
  balanceDelta  Decimal        @default(0) @db.Decimal(19, 4)
  pointDelta    Decimal        @default(0) @db.Decimal(19, 4)
  coinDelta     Decimal        @default(0) @db.Decimal(19, 4)
  expDelta      Int            @default(0)
  note          String?
  createdAt     DateTime       @default(now())

  profile FarmProfile @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@index([discordUserId, createdAt])
  @@index([discordUserId, actionType, createdAt])
}

model FarmVisit {
  id              String   @id @default(cuid())
  viewerDiscordId String
  targetDiscordId String
  visitCount      Int      @default(1)
  createdAt       DateTime @default(now())
  lastVisitedAt   DateTime @default(now())

  @@unique([viewerDiscordId, targetDiscordId])
  @@index([viewerDiscordId, lastVisitedAt])
  @@index([viewerDiscordId, visitCount])
}

model VoicePointSession {
  id              String   @id @default(cuid())
  discordUserId   String
  guildId         String
  channelId       String
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  eligibleSeconds Int      @default(0)
  pointsAwarded   Decimal  @default(0) @db.Decimal(19, 4)
  closeReason     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  ledger VoicePointLedger?

  @@index([discordUserId, joinedAt])
  @@index([discordUserId, leftAt])
  @@index([guildId, channelId, joinedAt])
}

model VoicePointLedger {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  discordUserId   String
  guildId         String
  channelId       String
  durationSeconds Int
  points          Decimal  @db.Decimal(19, 4)
  ruleVersion     String?
  createdAt       DateTime @default(now())

  member  Member            @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  session VoicePointSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([discordUserId, createdAt])
  @@index([guildId, channelId, createdAt])
}

model PageViewEvent {
  id            String   @id @default(cuid())
  path          String
  visitorId     String
  discordUserId String?
  referrer      String?
  userAgent     String?
  createdAt     DateTime @default(now())

  member Member? @relation(fields: [discordUserId], references: [discordUserId], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([discordUserId, createdAt])
}

model Transaction {
  Transid   String   @id @default(cuid())
  orderID   Int      @unique @default(autoincrement())
  fromId    String
  toId      String
  amount    Decimal  @db.Decimal(19, 4)
  feeAmount Decimal  @db.Decimal(19, 4)
  netAmount Decimal  @db.Decimal(19, 4)
  createdAt DateTime @default(now())

  commissionById    Commission? @relation("commissionById")
  commissionByOrder Commission? @relation("commissionByOrder")

  from Member @relation("FromMember", fields: [fromId], references: [discordUserId])
  to   Member @relation("ToMember", fields: [toId], references: [discordUserId])
}

model Withdraw {
  id         String   @id @default(dbgenerated("concat('W', nextval('\"Withdraw_id_seq\"'::regclass))"))
  discordId  String
  createdAt  DateTime @default(now())
  amount     Decimal  @db.Decimal(19, 4)
  method     String
  notifiedAt DateTime?

  @@index([discordId])
}

model IndividualTransaction {
  transactionId      String   @id @default(dbgenerated("concat('IT', nextval('\"IndividualTransaction_transactionId_seq\"'::regclass))"))
  timeCreatedAt      DateTime @default(now())
  discordId          String
  thirdPartydiscordId String
  balanceBefore      Decimal  @db.Decimal(19, 4)
  amountChange       Decimal  @db.Decimal(19, 4)
  balanceAfter       Decimal  @db.Decimal(19, 4)
  typeOfTransaction  String

  @@index([discordId])
  @@index([discordId, timeCreatedAt, typeOfTransaction])
}

model WithdrawalAccount {
  discordUserId String   @id
  account1      String?
  account2      String?
  account3      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
}

enum CouponType {
  DISCOUNT_90
  DISCOUNT_80
  DISCOUNT_70
  DISCOUNT_90_LOTTERY
  CAKE_VOUCHER
  LOLLIPOP_VOUCHER
  PERFUME_VOUCHER
  CAROUSEL_VOUCHER
  PUMPKIN_CAR_VOUCHER
  PHONOGRAPH_VOUCHER
  CROWN_75_VOUCHER
  CROWN_DAY_90_VOUCHER
  CROWN_3DAY_90_VOUCHER
  CROWN_WEEK_90_VOUCHER
  CROWN_MONTH_90_VOUCHER
  LOTTERY_VOUCHER
  CUSTOM_GIFT_VOUCHER
  CUSTOM_TAG_VOUCHER
  COMMISSION_MINUS1_VOUCHER
  DOUBLE_FLOW_5000_VOUCHER
  DOUBLE_SPEND_5000_VOUCHER
  RENAME_CARD_3
  RENAME_CARD
  RENAME_CARD_5
  PEIWAN_REVIEW_VOUCHER
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
}

model Coupon {
  id        String      @id @default(dbgenerated("concat('C', nextval('\"Coupon_id_seq\"'::regclass))"))
  discordId String
  type      CouponType
  status    CouponStatus @default(ACTIVE)
  issuedAt  DateTime    @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  orderId   String?
  consumeAmount Decimal? @db.Decimal(19, 4)
  consumeTargetId String?

  consumeTarget Member? @relation("CouponConsumeTarget", fields: [consumeTargetId], references: [discordUserId])
}

model Expense {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(19, 4)
  operatorId String
  targetId   String?
  reason     String
  createdAt  DateTime @default(now())

  operator Member @relation("ExpenseOperator", fields: [operatorId], references: [discordUserId])
  target   Member? @relation("ExpenseTarget", fields: [targetId], references: [discordUserId])

  @@index([operatorId])
  @@index([targetId])
  @@index([createdAt])
}

model PureProfit {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(19, 4)
  operatorId String
  targetId   String?
  reason     String
  createdAt  DateTime @default(now())

  operator Member @relation("PureProfitOperator", fields: [operatorId], references: [discordUserId])
  target   Member? @relation("PureProfitTarget", fields: [targetId], references: [discordUserId])

  @@index([operatorId])
  @@index([targetId])
  @@index([createdAt])
}

model DailySnapshot {
  date          DateTime @db.Date
  discordUserId String
  totalEarn     Decimal  @db.Decimal(19, 4)
  totalSpent    Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)

  @@id([date, discordUserId])
  @@index([date])
}

model Commission {
  transactionId String   @id
  orderID       Int      @unique @default(autoincrement())
  fromId        String
  toId          String
  feeAmount     Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  transactionByID    Transaction @relation("commissionById", fields: [transactionId], references: [Transid], onDelete: Cascade)
  transactionByOrder Transaction @relation("commissionByOrder", fields: [orderID], references: [orderID], onDelete: Cascade)

  from Member @relation("CommissionFrom", fields: [fromId], references: [discordUserId])
  to   Member @relation("CommissionTo", fields: [toId], references: [discordUserId])
}

model InteractionLog {
  Interid   String   @id @default(cuid())
  memberId  String?
  command   String?
  payload   Json?
  createdAt DateTime @default(now())
}

model Gift {
  GiftName String   @id
  price    Decimal? @db.Decimal(19, 4)
  url_link String?
  active   Boolean  @default(true)
  rate     Decimal  @default(1) @db.Decimal(10, 2)

  unlocks PeiwanGiftUnlock[]
  giftImage GiftImage?
}

model GiftImage {
  giftName  String   @id
  fileName  String
  category  String   @default("默认")
  uploadedAt DateTime @default(now())

  gift Gift @relation(fields: [giftName], references: [GiftName], onDelete: Cascade)
}

model GiftAudit {
  id                       String   @id @default(cuid())
  paymentTransactionId     String   @unique
  individualTransactionId  String   @unique
  orderId                  Int
  giftName                 String
  quantity                 Decimal  @db.Decimal(19, 4)
  unitPrice                Decimal  @db.Decimal(19, 4)
  gross                    Decimal  @db.Decimal(19, 4)
  payable                  Decimal  @db.Decimal(19, 4)
  pointsEarned             Decimal  @db.Decimal(19, 4) // loyalty points awarded to giver for this gift
  feeAmount                Decimal  @db.Decimal(19, 4)
  netAmount                Decimal  @db.Decimal(19, 4)
  receiverRate             Decimal  @db.Decimal(19, 6)
  heartGain                Int
  giverId                  String
  receiverId               String
  giverFromIncome          Decimal  @db.Decimal(19, 4)
  giverFromRecharge        Decimal  @db.Decimal(19, 4)
  spendBonusExtra          Decimal  @db.Decimal(19, 4)
  spendRemainingBefore     Decimal  @db.Decimal(19, 4)
  flowBonusExtra           Decimal  @db.Decimal(19, 4)
  flowRemainingBefore      Decimal  @db.Decimal(19, 4)
  voucherIds               Json?
  couponIds                Json?
  bossReferralInviterId    String?
  bossReferralAmount       Decimal? @db.Decimal(19, 4)
  workerReferralInviterId  String?
  workerReferralAmount     Decimal? @db.Decimal(19, 4)
  createdAt                DateTime @default(now())

  @@map("gift_audit")
}

model OrderAudit {
  id                          String   @id @default(cuid())
  orderId                     String   @unique
  paymentTransactionId        String   @unique
  transactionOrderId          Int      @unique
  hostIndividualTransactionId String?  @unique
  workerIndividualTransactionId String? @unique
  hostId                      String
  workerId                    String
  peiwanId                    Int
  gross                       Decimal  @db.Decimal(19, 4)
  pointsEarned                Decimal  @db.Decimal(19, 4)
  feeAmount                   Decimal  @db.Decimal(19, 4)
  netAmount                   Decimal  @db.Decimal(19, 4)
  commissionRate              Decimal  @db.Decimal(19, 6)
  hostFromIncome              Decimal  @db.Decimal(19, 4)
  hostFromRecharge            Decimal  @db.Decimal(19, 4)
  spendBonusExtra             Decimal  @db.Decimal(19, 4)
  spendRemainingBefore        Decimal  @db.Decimal(19, 4)
  bossReferralInviterId       String?
  bossReferralAmount          Decimal? @db.Decimal(19, 4)
  workerReferralInviterId     String?
  workerReferralAmount        Decimal? @db.Decimal(19, 4)
  createdAt                   DateTime @default(now())

  @@map("order_audit")
}

model LeaderboardPost {
  id          String   @id @default(cuid())
  kind        String
  periodStart DateTime
  createdAt   DateTime @default(now())

  @@unique([kind, periodStart])
  @@index([kind])
}

model LeaderboardPostChannel {
  id          String   @id @default(cuid())
  kind        String
  periodStart DateTime
  channelId   String
  createdAt   DateTime @default(now())

  @@unique([kind, periodStart, channelId])
  @@index([kind])
  @@index([channelId])
}

model PeiwanGiftUnlock {
  id            String   @id @default(cuid())
  discordUserId String
  giftName      String
  unlockedAt    DateTime @default(now())

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
  gift   Gift   @relation(fields: [giftName], references: [GiftName], onDelete: Cascade)

  @@unique([discordUserId, giftName])
  @@index([discordUserId])
}

model PeiwanGiftRewardClaim {
  id            String   @id @default(cuid())
  discordUserId String
  rewardKey     String
  grantedAt     DateTime @default(now())

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@unique([discordUserId, rewardKey])
  @@index([discordUserId])
}

model Recharge {
  RechargeID String  @id @default(dbgenerated("concat('C', nextval('\"Recharge_RechargeID_seq\"'::regclass))"))
  amount     Decimal @db.Decimal(19, 4)
  toWhom     String
  fromWhom   String  @default("1421651539247894549")
  createdAt  DateTime @default(now())
}

model ZPayRechargeOrder {
  id            String               @id @default(dbgenerated("concat('ZPAY', replace((gen_random_uuid())::text, '-'::text, ''::text))"))
  outTradeNo    String               @unique
  discordUserId String
  amount        Decimal              @db.Decimal(19, 4)
  channel       String
  status        RechargeOrderStatus  @default(PENDING)
  gatewayTradeNo String?
  notifyPayload Json?
  createdAt     DateTime             @default(now())
  paidAt        DateTime?

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)

  @@index([status, createdAt])
}

model PEIWAN {
  PEIWANID      Int    @id
  discordUserId String @unique

  // Required: every 陪玩 must have a default quotation *code*
  defaultQuotationCode QuotationCode

  // Price slots (include DEFAULT)
  quotation_Q1 Decimal? @db.Decimal(10, 2)
  lolPrice    Decimal? @db.Decimal(10, 2)
  valPrice    Decimal? @db.Decimal(10, 2)
  deltaPrice  Decimal? @db.Decimal(10, 2)
  csgoPrice   Decimal? @db.Decimal(10, 2)
  narakaPrice Decimal? @db.Decimal(10, 2)
  apexPrice   Decimal? @db.Decimal(10, 2)
  owPrice     Decimal? @db.Decimal(10, 2)
  tftPrice    Decimal? @db.Decimal(10, 2)
  steamPrice  Decimal? @db.Decimal(10, 2)

  // Payout rate copy on PEIWAN (synced → Member via DB trigger)
  commissionRate Decimal @default(0.75) @db.Decimal(7, 6)
  // Original payout share baseline for future reset logic
  baseCommissionRate Decimal @default(0.75) @db.Decimal(7, 6)

  totalEarn Decimal      @default(0) @db.Decimal(19, 4)
  balance   Decimal      @default(0) @db.Decimal(19, 4)
  MP_url    String?
  status    PeiwanStatus @default(free)
  serverDisplayName String?
  sex       PeiwanSex    @default(小姐姐)
  exclusive Boolean      @default(false)
  type      PeiwanType   @default(娱乐陪玩)
  level     PeiwanLevel  @default(优选陪玩)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation("MemberToPeiwan", fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  // Back-relation to Order for the peiwan relation
  orders Order[] @relation("PeiwanOrders")
  gameProfiles PeiwanGameProfile[]

  @@index([status])
}

model PeiwanGameProfile {
  id            String         @id @default(cuid())
  peiwanId      Int
  discordUserId String
  gameCode      PeiwanGameCode
  tier          PeiwanGameTier
  source        String?
  sourceRoleId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  peiwan PEIWAN @relation(fields: [peiwanId], references: [PEIWANID], onDelete: Cascade)

  @@unique([peiwanId, sourceRoleId])
  @@index([discordUserId])
  @@index([gameCode, tier])
}

model Order {
  id       String @id @default(cuid()) // orderId
  hostId   String
  workerId String
  peiwanId Int
  displayNo Int @default(autoincrement()) @unique

  host   Member @relation("HostOrders", fields: [hostId], references: [discordUserId], onDelete: Restrict)
  worker Member @relation("WorkerOrders", fields: [workerId], references: [discordUserId], onDelete: Restrict)
  peiwan PEIWAN @relation("PeiwanOrders", fields: [peiwanId], references: [PEIWANID], onDelete: Restrict)

  mode   OrderMode
  status OrderStatus @default(PENDING)

  // Price snapshot
  quotationCode QuotationCode
  unitPrice     Decimal       @db.Decimal(10, 2)

  // Timing (5-min delayed stopwatch billing)
  createdAt        DateTime  @default(now())
  acceptedAt       DateTime?
  billableStartAt  DateTime? // = acceptedAt + 5min
  stopwatchStartAt DateTime? // = acceptedAt
  cutoffAt         DateTime? // = acceptedAt + maxMinutes

  // Recalc snapshot & telemetry
  maxMinutesAtAccept Int?
  lastRecalcAt       DateTime?
  chargedMinutes     Int      @default(0)
  chargedGross       Decimal  @default(0) @db.Decimal(19, 4)

  endedAt      DateTime?
  notifiedAt   DateTime?
  totalMinutes Int? // ceil((endedAt - stopwatchStartAt)/60)

  // Money (gross two-decimal; payout snapshot is worker share)
  grossAmount    Decimal? @db.Decimal(18, 2)
  commissionRate Decimal? @db.Decimal(7, 6) // snapshot of worker payout share at accept
  netAmount      Decimal? @db.Decimal(18, 2)

  interId String?

  // Back-relation for WorkerLock (one active lock per order at most)
  workerLock WorkerLock? @relation("OrderWorkerLock")

  @@index([status, cutoffAt])
  @@index([workerId, status])
  @@index([hostId, status])
}

model OrderRequestLog {
  orderId   String   @id
  ownerId   String
  ownerDisplayName String?
  content   String
  createdAt DateTime @default(now())

  owner  Member             @relation("OrderRequestOwner", fields: [ownerId], references: [discordUserId], onDelete: Cascade)
  clicks OrderRequestClick[]

  @@index([ownerId])
}

model OrderRequestClick {
  id        String   @id @default(cuid())
  orderId   String
  workerId  String
  workerDisplayName String?
  clickedAt DateTime @default(now())

  request OrderRequestLog @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  worker  Member          @relation("OrderRequestWorker", fields: [workerId], references: [discordUserId], onDelete: Cascade)

  @@unique([orderId, workerId])
  @@index([orderId])
  @@index([workerId])
}

model BossChannelBinding {
  channelId String  @id
  ownerId   String
  enabled   Boolean @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, enabled])
  @@index([enabled, updatedAt])
}

model PeiwanDeletion {
  peiwanId      Int      @id
  discordUserId String
  deletedBy     String?
  deletedAt     DateTime @default(now())

  @@index([discordUserId])
}

model WorkerLock {
  workerId  String   @unique
  orderId   String   @unique
  createdAt DateTime @default(now())

  // Name relations to avoid ambiguity
  worker Member @relation("MemberWorkerLock", fields: [workerId], references: [discordUserId], onDelete: Cascade)
  order  Order  @relation("OrderWorkerLock", fields: [orderId], references: [id], onDelete: Cascade)
}

model HeartCounter {
  id           Int    @id @default(autoincrement())
  fromMemberId String
  toMemberId   String
  total        Int    @default(0)

  fromMember Member @relation("HeartFrom", fields: [fromMemberId], references: [discordUserId], onDelete: Cascade)
  toMember   Member @relation("HeartTo", fields: [toMemberId], references: [discordUserId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromMemberId, toMemberId])
}

model RedEnvelope {
  id              String             @id @default(cuid())
  creatorId       String
  totalAmount     Decimal            @db.Decimal(19, 4)
  remainingAmount Decimal            @db.Decimal(19, 4)
  totalCount      Int
  remainingCount  Int
  note            String?
  status          RedEnvelopeStatus  @default(ACTIVE)
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messageId       String?
  channelId       String?
  refundedAmount  Decimal?           @db.Decimal(19, 4)
  incomePool      Decimal            @db.Decimal(19, 4)
  rechargePool    Decimal            @db.Decimal(19, 4)

  @@index([status, expiresAt])
}

model LotteryPrize {
  id           String      @id @default(cuid())
  name         String
  pool         LotteryPool
  type         LotteryPrizeType @default(COUPON)
  weight       Int
  unlimited    Boolean     @default(false)
  stock        Int?
  imageUrl     String?
  active       Boolean     @default(true)

  draws LotteryDraw[]
}

model CommissionBuff {
  userId    String   @id @map("user_id")
  boost     Decimal  @db.Decimal(10, 4)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("commission_buff")
}

model AutoCommissionBuff {
  userId          String   @id @map("user_id")
  targetShare     Decimal  @db.Decimal(10, 4) @default(0.91) @map("target_share")
  thresholdAmount Decimal  @db.Decimal(19, 4) @default(12000) @map("threshold_amount")
  windowDays      Int      @default(30) @map("window_days")
  windowStart     DateTime @map("window_start")
  windowEnd       DateTime @map("window_end")
  currentAmount   Decimal  @db.Decimal(19, 4) @default(0) @map("current_amount")
  tierExpiries    Json?    @map("tier_expiries")
  activeUntil     DateTime? @map("active_until")
  lastQualifiedAt DateTime? @map("last_qualified_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("auto_commission_buff")
}

model FlowBuff {
  userId         String   @id @map("user_id")
  remainingExtra Decimal  @db.Decimal(19, 4) @map("remaining_extra")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("flow_buff")
}

model SpendBuff {
  userId         String   @id @map("user_id")
  remainingExtra Decimal  @db.Decimal(19, 4) @map("remaining_extra")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("spend_buff")
}

model LotteryDraw {
  id        String      @id @default(cuid())
  nonce     String      @unique
  requestId String?
  userId    String
  pool      LotteryPool
  prizeId   String?
  cost      Decimal     @db.Decimal(19, 4)
  random    Float?
  createdAt DateTime    @default(now())
  status    LotteryStatus @default(UNUSED)
  code      String?       @unique
  expiresAt DateTime?
  consumeAt DateTime?
  consumeAmount Decimal?  @db.Decimal(19, 4) // 奖品使用时带来的金额（折扣/返利等）
  consumeOrderId String?  // 关联使用的订单
  consumeTargetId String?

  prize  LotteryPrize? @relation(fields: [prizeId], references: [id])
  member Member        @relation(fields: [userId], references: [discordUserId])
  consumeTarget Member? @relation("LotteryConsumeTarget", fields: [consumeTargetId], references: [discordUserId])

  @@index([userId, createdAt])
  @@index([pool, createdAt])
  @@index([consumeOrderId])
  @@index([consumeTargetId])
}

model LotteryPity {
  userId    String   @id
  missCount Int      @default(0)
  updatedAt DateTime @updatedAt

  user Member @relation(fields: [userId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
}

enum LotteryStatus {
  UNUSED
  USED
  EXPIRED
}

enum BlockStackStatus {
  ACTIVE
  COLLAPSED
  SETTLED
}

enum BlockStackAction {
  SINGLE
  TEN
  SETTLE
}

enum ScratchTicketStatus {
  UNSOLD
  SOLD
  REVEALED
}

enum ScratchPrizeType {
  THANKS
  P5
  P10
  P20
  P30
  P50
  P52
  P100
  P150
  P99
  P200
}

enum PointShopCartStatus {
  OPEN
  CHECKED_OUT
  ABANDONED
}

enum PointShopOrderStatus {
  SUCCESS
  FAILED
}

enum PointShopDeliveryType {
  COUPON
  MANUAL
  BALANCE
}

enum PointShopDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum PointShopPointLedgerType {
  DEBIT
  CREDIT
  ADJUST
}

enum ReferralType {
  LAOBAN
  PEIWAN
}

/// 手工指定唯一邀请人及类型（老板/陪玩）
model Referral {
  inviteeId String @id
  inviterId String
  type      ReferralType
  payoutRate Decimal @default(0.01) @db.Decimal(10, 4)
  payoutCap  Decimal? @default(1000) @db.Decimal(19, 4)
  policyApplied Boolean @default(false)
  policyRuleId  String?
  policyBoundAt DateTime?
  createdAt DateTime @default(now())

  inviter Member @relation("ReferralInviter", fields: [inviterId], references: [discordUserId])
  invitee Member @relation("ReferralInvitee", fields: [inviteeId], references: [discordUserId])
  payouts ReferralPayout[]

  @@index([inviterId, type])
}

model ReferralPolicy {
  id           String       @id @default(cuid())
  inviterId    String
  referralType ReferralType?
  rate         Decimal      @db.Decimal(10, 4)
  capAmount    Decimal?     @db.Decimal(19, 4)
  enabled      Boolean      @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([inviterId, enabled, createdAt])
  @@index([referralType, enabled, createdAt])
}

/// 记录每单邀请提成的发放（幂等：referralId+orderId 唯一）
model ReferralPayout {
  id         String   @id @default(cuid())
  referralId String
  orderId    String
  amount     Decimal  @db.Decimal(19, 4)
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [inviteeId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([referralId, orderId])
}

model BlockStackGame {
  id        String           @id @default(cuid())
  creatorId String
  channelId String
  messageId String?
  actionMessageId String?
  status    BlockStackStatus @default(ACTIVE)

  totalBlocks      Int @default(0)
  totalSingleDraws Int @default(0)
  totalTenDraws    Int @default(0)
  totalRevenue     Decimal @default(0) @db.Decimal(19, 4)

  settledAt     DateTime?
  settledById   String?
  settledAmount Decimal? @db.Decimal(19, 4)

  collapsedAt            DateTime?
  collapsedById          String?
  collapsedByAction      BlockStackAction?
  collapseChance         Decimal? @db.Decimal(7, 4)
  collapseRoll           Decimal? @db.Decimal(7, 4)
  collapseEnvelopeAmount Decimal? @db.Decimal(19, 4)
  collapseEnvelopeId     String?

  collapseRewardUserId   String?
  collapseRewardGross    Decimal? @db.Decimal(19, 4)
  collapseRewardNet      Decimal? @db.Decimal(19, 4)
  collapseRewardTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players BlockStackPlayer[]
  draws   BlockStackDraw[]

  @@index([channelId, status])
  @@index([collapseEnvelopeId])
}

model BlockStackPlayer {
  id           String   @id @default(cuid())
  gameId       String
  userId       String
  singlePicked Boolean  @default(false)
  singleBlocks Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game BlockStackGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
}

model BlockStackDraw {
  id          String           @id @default(cuid())
  gameId      String
  userId      String
  action      BlockStackAction
  blocksAdded Int
  createdAt   DateTime @default(now())

  game BlockStackGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
}

model ScratchTicket {
  id                    String              @id @default(cuid())
  code                  String              @unique
  serialNo              Int                 @unique
  status                ScratchTicketStatus @default(UNSOLD)
  prizeType             ScratchPrizeType
  prizeAmount           Decimal             @default(0) @db.Decimal(19, 4)
  ownerId               String?
  revealedAt            DateTime?
  revealMessageId       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  owner Member? @relation("ScratchTicketOwner", fields: [ownerId], references: [discordUserId], onDelete: SetNull)

  @@index([status, serialNo])
  @@index([ownerId, status])
}

model PointShopItem {
  id              String                @id @default(cuid())
  sku             String                @unique
  name            String
  description     String?
  pointsCost      Decimal               @db.Decimal(19, 4)
  stock           Int?
  isActive        Boolean               @default(true)
  deliveryType    PointShopDeliveryType @default(COUPON)
  couponType      CouponType?
  couponExpireDays Int?
  balanceCreditAmount Decimal?          @db.Decimal(19, 4)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  cartItems  PointShopCartItem[]
  orderItems PointShopOrderItem[]

  @@index([isActive, sortOrder])
}

model PointShopCart {
  id            String              @id @default(cuid())
  discordUserId String
  /// One OPEN cart per user is enforced by migration partial unique index.
  status        PointShopCartStatus @default(OPEN)
  version       Int                 @default(1)
  checkedOutAt  DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  items  PointShopCartItem[]
  orders PointShopOrder[]

  @@index([discordUserId, status, updatedAt])
}

model PointShopCartItem {
  id              String   @id @default(cuid())
  cartId          String
  itemId          String
  quantity        Int      @default(1)
  unitPoints      Decimal  @db.Decimal(19, 4)
  itemNameSnapshot String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cart PointShopCart @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  item PointShopItem @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, itemId])
  @@index([cartId, createdAt])
}

model PointShopOrder {
  id            String               @id @default(cuid())
  discordUserId String
  cartId        String?
  requestKey    String
  status        PointShopOrderStatus @default(SUCCESS)
  totalPoints   Decimal              @db.Decimal(19, 4)
  totalItems    Int                  @default(0)
  errorCode     String?
  createdAt     DateTime             @default(now())

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  cart   PointShopCart? @relation(fields: [cartId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items  PointShopOrderItem[]
  pointLedgers PointShopPointLedger[]
  grants PointShopGrant[]

  @@unique([discordUserId, requestKey])
  @@index([discordUserId, createdAt])
  @@index([cartId])
}

model PointShopOrderItem {
  id            String                  @id @default(cuid())
  orderId       String
  itemId        String?
  itemSku       String
  itemName      String
  unitPoints    Decimal                 @db.Decimal(19, 4)
  quantity      Int
  subtotalPoints Decimal                @db.Decimal(19, 4)
  deliveryStatus PointShopDeliveryStatus @default(PENDING)
  deliveryNote  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  order PointShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  item  PointShopItem? @relation(fields: [itemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  grants PointShopGrant[]

  @@index([orderId, createdAt])
}

model PointShopGrant {
  id            String       @id @default(cuid())
  orderId       String
  orderItemId   String
  discordUserId String
  deliveryType  PointShopDeliveryType @default(COUPON)
  itemSku       String
  itemName      String
  quantity      Int          @default(1)
  unitPoints    Decimal      @db.Decimal(19, 4)
  subtotalPoints Decimal     @db.Decimal(19, 4)
  deliveryStatus PointShopDeliveryStatus @default(PENDING)
  deliveryNote  String?
  couponType    CouponType?
  couponStatus  CouponStatus? @map("status")
  issuedAt      DateTime     @default(now())
  expiresAt     DateTime?
  consumedAt    DateTime?
  consumeAmount Decimal?     @db.Decimal(19, 4)
  consumeTargetId String?
  consumeOrderId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order       PointShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItem   PointShopOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner       Member @relation("PointShopGrantOwner", fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  consumeTarget Member? @relation("PointShopGrantConsumeTarget", fields: [consumeTargetId], references: [discordUserId])

  @@index([discordUserId, couponStatus, expiresAt])
  @@index([discordUserId, deliveryType, deliveryStatus, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([consumeTargetId])
  @@map("PointShopGrant")
}

model PointShopPointLedger {
  id            String                  @id @default(cuid())
  discordUserId String
  orderId       String?
  ledgerType    PointShopPointLedgerType
  deltaPoints   Decimal                 @db.Decimal(19, 4)
  balanceBefore Decimal                 @db.Decimal(19, 4)
  balanceAfter  Decimal                 @db.Decimal(19, 4)
  reason        String
  createdAt     DateTime                @default(now())

  member Member @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  order  PointShopOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([discordUserId, createdAt])
  @@index([orderId])
}

enum PeiwanReviewDisplayMode {
  HIDDEN
  ANONYMOUS
  REALNAME
}

model PeiwanReview {
  id                String                  @id @default(cuid())
  sourceGrantId     String?                 @unique
  reviewerDiscordId String
  reviewerName      String?
  peiwanDiscordId   String
  peiwanName        String?
  peiwanId          Int?
  content           String                  @db.VarChar(500)
  displayMode       PeiwanReviewDisplayMode @default(HIDDEN)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  reviewer Member @relation("PeiwanReviewReviewer", fields: [reviewerDiscordId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)
  peiwan   Member @relation("PeiwanReviewPeiwan", fields: [peiwanDiscordId], references: [discordUserId], onDelete: Cascade, onUpdate: Cascade)

  @@index([peiwanDiscordId, displayMode, createdAt])
  @@index([reviewerDiscordId, createdAt])
}

model Revert {
  id                     String   @id @default(cuid())
  originalTransactionId  String   @unique
  operatorId             String
  reason                 String?
  status                 String   @default("PENDING")
  details                Json?
  createdAt              DateTime @default(now())
  @@map("revert")
}

/// 记录用户是否曾经进入过目标 Guild（只插入一次，用于防止重复邀请奖励）
model GuildJoinRecord {
  userId       String   @id
  guildId      String
  firstJoinedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([guildId])
}

/// 邀请链接使用并发放 2 元奖励的流水（不依赖 Referral 表）
model InviteLinkUsage {
  id         String   @id @default(cuid())
  guildId    String
  inviteeId  String   @unique
  inviterId  String
  code       String?
  rewardedAt DateTime @default(now())
  rewardAmount Decimal @db.Decimal(19, 4)
  createdAt  DateTime @default(now())

  inviter Member @relation("MemberToInviteLinkUsage", fields: [inviterId], references: [discordUserId], onDelete: Cascade)
  invitee Member @relation("InviteeToInviteLinkUsage", fields: [inviteeId], references: [discordUserId], onDelete: Cascade)

  @@index([guildId, inviterId])
}
